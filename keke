"""Aula 1, parte 1: lista de tarefas em Python procedural (exercício de lacunas).  Complete cada ___ com o código correto. O número entre parênteses no comentário da linha identifica a lacuna no gabarito. Dica: o arquivo abre sem erro de sintaxe, mas só roda depois que todas as lacunas estiverem preenchidas (senão aparece NameError: name '___').  Tudo fica em memória (listas e dicionários) e some quando o programa fecha. Na parte 2 o mesmo sistema vira POO com banco SQLite. """  # ---------------------------------------------------------------- dados # Cada usuário e cada tarefa é um dicionário dentro de uma lista. # Atenção: senha em texto puro só aqui, para aprender. Na parte 2 vira hash. usuarios = [     {"id": 1, "nome": "Administrador", "login": "admin", "senha": "admin123", "perfil": "admin"}, ] tarefas = [] proximo_id_usuario = 2 proximo_id_tarefa = 1   # ---------------------------------------------------------------- usuários def entrar(login, senha):     """Devolve o usuário se login e senha conferem, senão None."""     for usuario in usuarios:         if usuario["login"] == login and usuario["senha"] == senha:  # (1)             return usuario     return usuario["login"] # (2)  def cadastrar(nome, login, senha):     """Cadastra um usuário comum. Devolve uma mensagem de erro ou None se deu certo."""     global proximo_id_usuario     if nome == "" or login == "":         return "Nome e login são obrigatórios."     if len(senha) <= 6:  # (3)         return "A senha precisa ter ao menos 6 caracteres."     for usuario in usuarios:         if usuario["login"] == login:             return "Esse login já está em uso."     usuarios.append({  # (4)         "id": proximo_id_usuario, "nome": nome, "login": login,         "senha": senha, "perfil": "usuario",     })     proximo_id_usuario += 1  # (5)     return None  def login_do_usuario(usuario_id):     for usuario in usuarios:         if usuario["id"] == usuario_id:  # (6)             return usuario["login"]     return "?"  def mostrar_usuarios():     for usuario in usuarios:         print(f"{usuario['id']:>3} | {usuario['login']:<12} | {usuario['perfil']:<7} | {usuario['nome']}")  # ---------------------------------------------------------------- tarefas def pode_acessar(usuario, tarefa):     """Regra de permissão: admin acessa tudo, usuário só o que é dele.     Repare que é um if sobre o perfil. Na POO isso vira polimorfismo."""     return usuario["perfil"] == "admin" or tarefa["usuario_id"] == usuario["id"]  # (7)  def tarefas_visiveis(usuario):     resultado = []     for tarefa in tarefas:         if pode_acessar(usuario, tarefa):  # (8)             resultado.append(tarefa)     return resultado  def buscar_tarefa(usuario, tarefa_id):     for tarefa in tarefas:         if tarefa["id"] == tarefa_id and pode_acessar(usuario, tarefa):  # (9)             return tarefa     return None  def criar_tarefa(usuario, titulo):     global proximo_id_tarefa     if titulo == "":         return "O título é obrigatório."     tarefas.append({         "id": proximo_id_tarefa, "titulo": titulo,         "concluida": False, "usuario_id": usuario["id"],  # (10)     })     proximo_id_tarefa += 1     return None  def alternar_tarefa(usuario, tarefa_id):     tarefa = buscar_tarefa(usuario, tarefa_id)     if tarefa is None:         return "Tarefa não encontrada (ou não é sua)."     tarefa["concluida"] = not tarefa["concluida"] # (11)     return None  def excluir_tarefa(usuario, tarefa_id):     tarefa = buscar_tarefa(usuario, tarefa_id)     if tarefa is None:         return "Tarefa não encontrada (ou não é sua)."     tarefas.remove(tarefa)  # (12)     return None  def mostrar_tarefas(usuario):     lista = tarefas_visiveis(usuario)     if len(lista) == 0:         print("Nenhuma tarefa.")         return     pendentes = 0     for tarefa in lista:         marca = "x" if tarefa["concluida"] else " "  # (13)         dono = ""         if usuario["perfil"] == "admin":             dono = f"  (de: {login_do_usuario(tarefa['usuario_id'])})"         print(f"[{marca}] #{tarefa['id']} {tarefa['titulo']}{dono}")         if not tarefa["concluida"]:             pendentes += 1     print(f"{pendentes} pendente(s) de {len(lista)}")  # (14)  # ---------------------------------------------------------------- menus def ler_inteiro(texto):     valor = input(texto).strip()     if valor.isdigit():  # (15)         return int(valor)  # (16)     return None  def menu_tarefas(usuario):     while True:         print(f"\n=== {usuario['nome']} ({usuario['perfil']}) ===")         print("1 - Listar tarefas")         print("2 - Nova tarefa")         print("3 - Concluir/reabrir tarefa")         print("4 - Excluir tarefa")         if usuario["perfil"] == "admin":             print("5 - Listar usuários")         print("0 - Sair")         opcao = input("Opção: ").strip()          erro = None         if opcao == "1":             mostrar_tarefas(usuario)         elif opcao == "2":             erro = criar_tarefa(usuario, input("Título: ").strip())  # (17)         elif opcao == "3":             erro = alternar_tarefa(usuario, ler_inteiro("ID da tarefa: "))         elif opcao == "4":             erro = excluir_tarefa(usuario, ler_inteiro("ID da tarefa: "))  # (18)         elif opcao == "5" and usuario["perfil"] == "admin":             mostrar_usuarios()         elif opcao == "0":             return         else:             erro = "Opção inválida."         if erro:             print("Erro:", erro)  def main():     while True:         print("\n=== Lista de Tarefas ===")         print("1 - Entrar")         print("2 - Cadastrar")         print("0 - Sair")         opcao = input("Opção: ").strip()         if opcao == "1":             usuario = entrar(input("Login: ").strip(), input("Senha: "))             if usuario is None:  # (19)                 print("Login ou senha incorretos.")             else:                 menu_tarefas(usuario)         elif opcao == "2":             erro = cadastrar(input("Nome: ").strip(), input("Login: ").strip(), input("Senha: "))             print(erro or "Cadastro feito. Agora entre.")         elif opcao == "0":             print("Até logo.")             return         else:             print("Opção inválida.")   if __name__ == "__main__":  # (20)     main()
